# ============================================================
# Tornbot - configuration
# Copy this file to .env and fill in your own values.
# NEVER commit your real .env (it is gitignored).
# ============================================================

# --- Required -------------------------------------------------

# Discord bot token (create a bot at https://discord.com/developers/applications)
DISCORD_TOKEN=

# Torn API key (https://www.torn.com/preferences.php#tab=api)
# Full Access for self/faction data; a key from your faction with Full Access unlocks faction features.
TORN_API_KEY=

# Your Torn faction ID (find it in your faction page URL: torn.com/factions.php?ID=xxxx)
FACTION_ID=

# One or more Discord channel IDs for the price board, comma-separated (e.g. "111,222")
BOARD_CHANNEL_IDS=

# Discord channel ID for chain monitoring alerts
CHAIN_CHANNEL_ID=

# --- Optional (safe to leave blank) ---------------------------

# Command prefix
PREFIX=!

# Optional second Torn API key (helps with rate limits / different permission scopes)
TORN_API_KEY_2=

# Optional FFScouter API key (a Torn key registered at ffscouter.com).
# !target / !target ff use each member's own registered key; this one is the
# fallback so the feature works even for members who never registered their own.
FFSCOUTER_API_KEY=

# Your Discord user ID (enables owner-only commands)
OWNER_DISCORD_ID=

# Encryption key for storing member account data (32-byte hex, 64 chars). Change this!
TORN_ENCRYPTION_KEY=

# A faction-member API key with Full Access (some faction endpoints need it)
FACTION_VAULT_KEY=

# Discord channel IDs for specific feeds (each falls back to CHAIN_CHANNEL_ID if blank)
WAR_CHANNEL_ID=
DIGEST_CHANNEL_ID=
BANK_CHANNEL_ID=
OC_CHANNEL_ID=
VERIFY_CHANNEL_ID=

# Channel to post new-member welcome messages (e.g. #new-arrivals). If blank,
# the bot DMs the newcomer instead.
WELCOME_CHANNEL_ID=
RETALIATION_CHANNEL_ID=

# Path to the permissions JSON file (tier assignments). If blank, defaults to ./permissions.json.
# Edit this file or use !tier / !permissions commands in Discord to manage tiers.
# Tiers: owner > co-owner > officer > member > public
PERMISSIONS_PATH=

# Discord channel ID of your #member-intro channel. The bot reads the timezone/location
# roster posted there (e.g. "Name, Location, UTC-5") and shows it in !members.
MEMBER_INTRO_CHANNEL_ID=

# Channel for the pinned, auto-updating !members board (defaults to MEMBER_INTRO_CHANNEL_ID).
# The board shows every member with a profile link, activity status and timezone.
MEMBER_BOARD_CHANNEL_ID=

# Minimum seconds between members-board refreshes (default 300). It piggybacks on the
# price-board cycle so it doesn't add extra API pings.
MEMBER_BOARD_INTERVAL=300

# How often each price-board API key polls its slice of the watchlist, in seconds
# (default 10). Torn's limit is 100 req/min per Torn account (across all its keys),
# so keep this high enough that ~ceil(watchlist/accounts) items per cycle stay under
# that, with headroom for commands and faction monitors. 7s is aggressive, 5s will
# start timing out.
PRICE_POLL_INTERVAL=10

# Minimum seconds between price-board Discord edits + alert DM scans (default 10).
# This only controls how often the Discord board is re-rendered, not Torn polling.
PRICE_BOARD_INTERVAL=10

# Optional: restrict rate-limited commands to one guild (your Discord server ID)
GUILD_ID=

# Local Ollama endpoint + model (used by the personal coach / knowledge-base features)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:32b

# Knowledge-base directory for the !coach feature and embedding model
KB_DIR=
KB_EMBED_MODEL=nomic-embed-text

# Daily guide: hour (0-23, local time) and whether to disable it entirely
GUIDE_HOUR=10
GUIDE_DISABLED=0

# Default hour (0-23, local time) for the !pray daily church reminder
PRAY_HOUR=12

# Path for the SQLite database (defaults to ./tornbot.db if blank)
DATABASE_PATH=
